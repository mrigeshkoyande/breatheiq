# BreatheIQ Environment Variables Example

# ==============================================================================
# Backend Configuration
# ==============================================================================
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Security & Authentication (JWT Only)
JWT_SECRET_KEY=change-this-in-production-use-a-32-byte-random-secret-key-1234
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Database (PostgreSQL with PostGIS for production; SQLite fallback for zero-setup demo)
# SQLite fallback: sqlite+aiosqlite:///./breatheiq.db
DATABASE_URL=sqlite+aiosqlite:///./breatheiq.db

# Global Demo Mode (true works with ZERO API keys using deterministic seeds)
DEMO_MODE=true

# External Environmental APIs (Server-Side Only)
OPENAQ_API_KEY=
OPENMETEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Google Gemini API (Server-Side Only for BreatheIQ Copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@breatheiq.local

# Optional SMTP Email (Printed to console in dev mode if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@breatheiq.local

# CORS Allow-list
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================================================
# Frontend Configuration (Vite)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEFAULT_LANGUAGE=en
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
