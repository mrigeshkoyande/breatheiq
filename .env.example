# ==============================================================================
# BreatheIQ Environment Variables Template (.env.example)
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Security & Authentication (JWT-only Argon2id)
JWT_SECRET_KEY=breatheiq-super-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (PostgreSQL with PostGIS for production; SQLite fallback for zero-setup demo)
# SQLite fallback: sqlite+aiosqlite:///./breatheiq.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/breatheiq
DATABASE_URL=sqlite+aiosqlite:///./breatheiq.db

# Global Demo Mode (true works with ZERO API keys using deterministic CPCB seeds)
DEMO_MODE=true

# External Environmental APIs (Server-Side Only)
OPENAQ_API_KEY=
OPENMETEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Google Gemini API (Server-Side Only for BreatheIQ Copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (JSON array or comma-separated string)
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# Frontend Configuration (Vite)
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_LANGUAGE=en
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
