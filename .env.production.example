# ==============================================================================
# BreatheIQ Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets or production credentials into git.
# - Configure these environment variables in your hosting provider dashboards
#   (e.g., Render Dashboard for Backend, Vercel Dashboard for Frontend).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service (Render / Cloud Run)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
DEBUG=false
SERVE_FRONTEND=true

# Security & Authentication (JWT-only Argon2id)
# Generate a strong 32+ character random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-32-byte-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
# Set to "lax" for single-origin (Render container); set to "none" if frontend is on Vercel
COOKIE_SAMESITE=lax

# Database (Render PostgreSQL connection string or internal SQLite)
# Note: postgres:// and postgresql:// are automatically mapped to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/breatheiq_db

# Environmental Telemetry & Demo Mode
DEMO_MODE=true
# Optional API keys for real telemetry and Gemini copilot
OPENAQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins
# Supply your Vercel production frontend domain and custom domain as a JSON array or CSV
ALLOWED_ORIGINS=["https://breatheiq.vercel.app"]

# ------------------------------------------------------------------------------
# 2. Frontend Application (Vercel)
# ------------------------------------------------------------------------------
# Point to your deployed FastAPI backend URL (e.g. on Render)
VITE_API_BASE_URL=https://breatheiq.onrender.com/api/v1
VITE_DEFAULT_LANGUAGE=en
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
